# Application
APP_NAME="ImaraChat API"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=*

# Database
DATABASE_ENGINE=sqlite
DATABASE_PATH=imarachat.db
# For MySQL/PostgreSQL set DATABASE_ENGINE and uncomment:
# DATABASE_ENGINE=postgresql
# DATABASE_NAME=imarachat
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=5432
# DATABASE_USER=postgres
# DATABASE_PASSWORD=change-me
LOG_QUERIES=false
USE_TZ=true

# Auth — generate a strong secret for anything other than local dev:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=dev-only-change-this-secret-key-before-deploying-imarachat
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
